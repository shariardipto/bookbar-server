# P00 runs with these non-secret defaults even without a .env file.
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# Database and JWT integrations begin in P02-P04. Supply credentials privately.
MONGODB_URI=
MONGODB_DB_NAME=bookbar
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:3000
BETTER_AUTH_AUDIENCE=http://localhost:3000
